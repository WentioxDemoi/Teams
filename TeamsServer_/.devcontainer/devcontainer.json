{
    "name": "TeamsServer",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "server",
    "workspaceFolder": "/app",
    "postCreateCommand": "mkdir -p build && cd build && cmake .. && cmake --build .",
    "customizations": {
        "vscode": {
            "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"]
        }
    }
}