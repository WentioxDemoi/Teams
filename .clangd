# Ce fichier concerne l'edition depuis macOS lorsque Docker Compose est lance
# separement, sans ouvrir VS Code dans le Dev Container.
#
# Dans ce mode, clangd s'execute sur le Mac et doit pouvoir trouver les dependances
# installees par Homebrew. Le serveur, lui, continue d'etre compile dans Docker.
# Le compile_commands.json genere dans le container contient des chemins /app/* et
# n'est donc pas directement exploitable par clangd sur macOS.
#
# Si VS Code est ouvert dans le Dev Container, ce fichier racine n'est pas monte
# dans /app et clangd utilise les bibliotheques Ubuntu installees par le Dockerfile.

CompileFlags:
  Add:
    - "-I/opt/homebrew/opt/boost/include"
    - "-I/opt/homebrew/opt/libpqxx/include"
    - "-I/opt/homebrew/opt/libpq/include"
    - "-I/opt/homebrew/opt/argon2/include"